// 4. Program to count total number of nodes in a linked list
#include <stdio.h>
#include <stdlib.h>
struct node {
    int data;
    struct node *next;
};
int countNodes(struct node *head) {
    int count = 0;
    while (head != NULL) {
        count++;
        head = head->next;
    }
    return count;
}
int main() {
    struct node *head = NULL, *newnode, *temp;
    for (int i = 1; i <= 4; i++) {
        newnode = (struct node *)malloc(sizeof(struct node));
        newnode->data = i * 10;
        newnode->next = NULL;
        if (head == NULL) head = temp = newnode;
        else {
            temp->next = newnode;
            temp = newnode;
        }
    }
    printf("Total number of nodes: %d", countNodes(head));
    return 0;
}
